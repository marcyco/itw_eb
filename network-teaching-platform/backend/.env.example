# 环境配置文件示例
# 复制此文件为 .env 并填入实际值

# ============================================
# 数据库配置
# ============================================

# MySQL 配置（生产环境）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=network_teaching

# SQLite 配置（开发/测试）
# 如果需要使用 SQLite，取消下面这行的注释并设置 USE_SQLITE=true
# DATABASE_URL=sqlite:///./network_teaching.db
USE_SQLITE=false

# ============================================
# 安全配置
# ============================================

# JWT 密钥（请修改为随机字符串）
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# 服务器配置
# ============================================

HOST=0.0.0.0
PORT=8000
DEBUG=false

# ============================================
# CORS 配置
# ============================================

# 允许的前端地址，多个地址用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# 日志配置
# ============================================

LOG_LEVEL=INFO
LOG_FILE=logs/app.log
